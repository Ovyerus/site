+/** Opt-in process role: set before starting the server, never at request time. */
+export function isReadOnly() {
+	const value = typeof process !== "undefined" ? process.env?.EMDASH_READ_ONLY : undefined;
+	if (value !== undefined && value !== "true" && value !== "false") {
+		throw new Error("EMDASH_READ_ONLY must be true or false when set");
+	}
+	return value === "true";
+}
+export function assertWritable() {
+	if (isReadOnly()) throw new Error("EmDash is read-only on this replica");
+}
