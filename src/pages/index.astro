---
import WordmarkGradient from "~assets/wordmark-gradient.svg";
import Webring from "~components/Webring.astro";
import Layout from "~layouts/Layout.astro";
import { getEmDashEntry, sanitizeHref } from "emdash";

interface HomeData {
  title: string;
  tagline: string;
  email: string;
  github: string;
  mastodon: string;
  bluesky: string;
}
const { entry, error } = await getEmDashEntry<"home", HomeData>("home", "home");
if (error) throw error;
if (!entry)
  return new Response("Publish the Homepage entry in EmDash.", { status: 503 });
const { title, tagline, email, github, mastodon, bluesky } = entry.data;
---

<Layout title={`Home - ${title}`} ogTitle={title} description={tagline}>
  <main class="content">
    <div class="neon h-1/2 min-h-[100px] flex-grow basis-[0]"></div>
    <div
      class="flex h-full flex-grow basis-[0] flex-col gap-5 p-2.5 md:h-1/2 md:p-5"
    >
      <WordmarkGradient
        class="h-auto w-full max-w-[600px]"
        role="heading"
        aria-level="1"
        aria-label={title}
      />
      <p>{tagline}</p>
      <nav>
        <p>
          Contact:&nbsp; <a
            class="font-bold"
            href={sanitizeHref(`mailto:${email}`)}
          >
            {email}
          </a>
        </p>
        <ul class="link-list">
          <li><a href="/about">about</a></li>
          <li><a href="/posts">posts</a></li>
          <li><a href="/weeknotes">weeknotes</a></li>
          <li><a href="/uses">uses</a></li>
        </ul>
      </nav>

      <div class="flex-1"></div>

      <footer class="flex flex-row flex-wrap-reverse justify-between">
        <ul class="link-list">
          <li><a rel="me" href={sanitizeHref(github)}>github</a></li>
          <li><a rel="me" href={sanitizeHref(mastodon)}>mastodon</a></li>
          <li>
            <a rel="me" href={sanitizeHref(bluesky)}>bluesky</a>
          </li>
        </ul>
        <ul class="link-list justify-end">
          <li><a href="/ssh.txt">ssh keys</a></li>
          <li><a href="/domains.txt">domains list</a></li>
        </ul>
      </footer>

      <Webring />
    </div>
  </main>
</Layout>
